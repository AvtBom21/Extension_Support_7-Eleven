{
  "manifest_version": 3,
  "name": "Bulk Final Approve / Reject",
  "version": "1.0.0",
  "description": "Sequentially bulk-approve or bulk-reject rows in a web page table.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Bulk Approve / Reject"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["confirm_patch.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
