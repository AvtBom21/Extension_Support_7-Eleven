{
  "manifest_version": 3,
  "name": "Product Lookup + Autofill",
  "version": "2.1.0",
  "description": "Search product data and autofill product form with safe dropdown handling",
  "action": {
    "default_title": "Product Lookup + Autofill",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs",
    "windows",
    "downloads"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "<all_urls>"
  ]
}