{
  "manifest_version": 3,
  "name": "Product Form Autofill",
  "version": "2.1.0",
  "description": "Tải dữ liệu sản phẩm, xem chi tiết và tự động điền form tạo sản phẩm.",
  "icons": {
    "16": "icon16.png",
    "32": "icon48.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Product Form Autofill",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon48.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "tabs",
    "windows",
    "downloads"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "<all_urls>"
  ]
}
