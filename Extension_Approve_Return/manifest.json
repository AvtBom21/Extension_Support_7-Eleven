{
  "manifest_version": 3,
  "name": "RS Auto Approver",
  "version": "1.0",
  "description": "Tự động tick checkbox Approve/Reject cho các mã RS trong danh sách",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
